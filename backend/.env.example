PORT=5000
NODE_ENV=development
SESSION_SECRET=shopsphere_secure_session_secret_change_in_production
CLIENT_URL=http://localhost:5173
DATABASE_PATH=./src/db/shopsphere.db

# OpenRouter Global Agent Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_TIMEOUT_MS=30000
AGENT_MAX_TOOL_ITERATIONS=6
AGENTS_ENABLED=true
AGENT_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
AGENT_DEFAULT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free
REFUND_AUTO_APPROVE_MAX_PAISE=200000

# Optional fallback master key if agent-specific key is not set
OPENROUTER_API_KEY=

# 1. Order Agent Keys & Models
ORDER_AGENT_API_KEY=
ORDER_AGENT_BACKUP_API_KEY=
ORDER_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
ORDER_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 2. Payment Agent Keys & Models (Mock/Simulated Only)
PAYMENT_AGENT_API_KEY=
PAYMENT_AGENT_BACKUP_API_KEY=
PAYMENT_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
PAYMENT_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 3. Warehouse Agent Keys & Models (Admin/Staff Only)
WAREHOUSE_AGENT_API_KEY=
WAREHOUSE_AGENT_BACKUP_API_KEY=
WAREHOUSE_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
WAREHOUSE_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 4. Tracking Agent Keys & Models
TRACKING_AGENT_API_KEY=
TRACKING_AGENT_BACKUP_API_KEY=
TRACKING_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
TRACKING_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 5. Customer Support Agent Keys & Models
SUPPORT_AGENT_API_KEY=
SUPPORT_AGENT_BACKUP_API_KEY=
SUPPORT_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
SUPPORT_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 6. Return Agent Keys & Models
RETURN_AGENT_API_KEY=
RETURN_AGENT_BACKUP_API_KEY=
RETURN_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
RETURN_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free

# 7. Refund Agent Keys & Models (Mock Refunds Only)
REFUND_AGENT_API_KEY=
REFUND_AGENT_BACKUP_API_KEY=
REFUND_AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
REFUND_AGENT_FALLBACK_MODEL=google/gemini-2.0-flash-lite-preview:free
